# Cache versioned assets indefinitely (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static SVGs and images
/*.svg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000

# HTML never cached indefinitely to allow instant updates
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
